<UserControl x:Class="GU_Exchange.Controls.NotificationScreenControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GU_Exchange.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="875" Background="#7FE4E4E4" SizeChanged="UserControl_SizeChanged" MouseDown="UserControl_MouseDown">
    <Grid x:Name="controlGrid" Background="#FFE4E4E4">
        <!-- #region Grid Layout. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MaxHeight="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- #endregion -->
        <!-- #region Grid Border. -->
        <Border BorderBrush="Black" BorderThickness="1" Grid.RowSpan="6"/>
        <!--#endregion-->
        <!-- #region Title. -->
        <Viewbox Grid.Row="0" Margin="10,10,10,10">
            <TextBlock x:Name="tbTitle" Text="Notifications" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black"/>
        </Viewbox>
        <!-- #region Close button. -->
        <Button x:Name="btnClose" Content="X" HorizontalAlignment="Right" Height="20" Grid.Row="0" Margin="0,0,0,0" VerticalAlignment="Top" Width="20" Click="BtnClose_Click"/>
        <!-- #endregion -->
        <ScrollViewer x:Name="svNotifications" Grid.Row="1" Margin="5,0,5,5">
            <WrapPanel x:Name="notificationPanel" Margin="0,0,0,0" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Visible" />
        </ScrollViewer>
        <!-- #endregion -->
    </Grid>
</UserControl>
